<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the AnkiDroid or AnkiQuest ContentProvider (SCHEMA.md §7, anki/FlashcardApp.kt). -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="org.ankiquest.ankidroid.permission.READ_WRITE_DATABASE" />
    <!-- Released AnkiQuest; remove once AnkiQuest-Android#420 has moved its users. -->
    <uses-permission android:name="com.ichi2.anki.quest.permission.READ_WRITE_DATABASE" />

    <!-- Android 11+ package visibility: AnkiDroid, AnkiQuest + Garmin Connect Mobile. -->
    <queries>
        <package android:name="com.ichi2.anki" />
        <package android:name="org.ankiquest.ankidroid" />
        <package android:name="com.ichi2.anki.quest" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <provider android:authorities="com.ichi2.anki.flashcards" />
        <provider android:authorities="org.ankiquest.ankidroid.flashcards" />
        <provider android:authorities="com.ichi2.anki.quest.flashcards" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Garmanki.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
